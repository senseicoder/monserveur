; Généré par le rôle Ansible "oocarto-deploy".
; Constantes de chemins (CHEMIN_LIB_PARTAGEE, CHEMIN_ZF…) : prepend des libs de
; l'hôte, monté en lecture seule (LIB_PARTAGEE remplacée par la copie synchronisée).
auto_prepend_file = /space/www/libs/prepend_central.inc.php
memory_limit = 512M
max_execution_time = 300
