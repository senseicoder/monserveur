# Généré par le rôle Ansible apache-backend, ne pas modifier à la main sur le serveur.
# TLS retiré : terminé par Traefik (frontal 80/443), Apache reste backend interne sur 8081.

<VirtualHost 172.18.0.1:8081>
	ServerName sophie.daneel.net
	ServerAdmin infra@epiconcept.fr

	DocumentRoot /var/www/sophie.daneel.net

	FileETag none

	<Directory />
		Options FollowSymLinks
		AllowOverride None
		Include auth/denied
	</Directory>

	<Directory /var/www/sophie.daneel.net>
		Options FollowSymLinks
		AllowOverride None
		Include auth/access
	</Directory>

	LogLevel warn
	ErrorLog /space/log/sophie.daneel.net/error.log
	CustomLog /space/log/sophie.daneel.net/access.log combined

	Include /etc/apache2/sites-available/sophie.daneel.net.d/
</VirtualHost>
