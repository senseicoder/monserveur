# Généré par le rôle Ansible apache-backend, ne pas modifier à la main sur le serveur.
# TLS retiré : terminé par Traefik (frontal 80/443), Apache reste backend interne sur 8081.

<VirtualHost 172.18.0.1:8081>
	ServerName bots.plcoder.net
	ServerAdmin infra@epiconcept.fr

	DocumentRoot /var/www/bots.plcoder.net

	Header unset ETag
	FileETag none

	<Directory />
		Options FollowSymLinks
		AllowOverride None
		Include auth/denied
	</Directory>

	<Directory /var/www/bots.plcoder.net>
		Options FollowSymLinks
		AllowOverride None
		Include auth/access
	</Directory>

	LogLevel warn
	ErrorLog /space/log/bots.plcoder.net/error.log
	CustomLog /space/log/bots.plcoder.net/access.log epiconcept

	Include /etc/apache2/sites-available/bots.plcoder.net.d/
</VirtualHost>
