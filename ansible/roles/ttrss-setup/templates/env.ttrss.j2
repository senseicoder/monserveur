# Généré par le rôle Ansible ttrss-setup, ne pas modifier à la main sur le serveur.
# Repris depuis ~/ttrss-docker/.env (config manuelle historique, jamais versionnée),
# secrets migrés vers le vault Ansible.

ADMIN_USER_PASS='{{ vault_ttrss_admin_password }}'
ADMIN_USER_ACCESS_LEVEL=10

AUTO_CREATE_USER={{ ttrss_auto_create_user }}
AUTO_CREATE_USER_PASS='{{ vault_ttrss_user_password }}'
AUTO_CREATE_USER_ACCESS_LEVEL=0

TTRSS_DB_USER={{ ttrss_db_user }}
TTRSS_DB_NAME={{ ttrss_db_name }}
TTRSS_DB_PASS={{ vault_ttrss_db_password }}

TTRSS_SELF_URL_PATH=https://{{ ttrss_domain }}/tt-rss
