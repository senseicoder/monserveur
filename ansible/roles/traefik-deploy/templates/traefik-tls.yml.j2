tls:
  certificates:
    - certFile: /certs/fullchain.pem
      keyFile: /certs/privkey.pem
    - certFile: /certs/vault/fullchain.pem
      keyFile: /certs/vault/privkey.pem
    - certFile: /certs/ntfy/fullchain.pem
      keyFile: /certs/ntfy/privkey.pem
    - certFile: /certs/puttini/fullchain.pem
      keyFile: /certs/puttini/privkey.pem
    - certFile: /certs/phpbb-integralsport/fullchain.pem
      keyFile: /certs/phpbb-integralsport/privkey.pem
    - certFile: /certs/reader-daneel/fullchain.pem
      keyFile: /certs/reader-daneel/privkey.pem
    - certFile: /certs/bots-plcoder/fullchain.pem
      keyFile: /certs/bots-plcoder/privkey.pem
    - certFile: /certs/pub-daneel-net/fullchain.pem
      keyFile: /certs/pub-daneel-net/privkey.pem
    - certFile: /certs/m3gan/fullchain.pem
      keyFile: /certs/m3gan/privkey.pem
{% if happy_domain is defined %}
    # Relais happy auto-hébergé (happy-server-deploy)
    - certFile: /certs/happy/fullchain.pem
      keyFile: /certs/happy/privkey.pem
{% endif %}
{% if relecture_domain is defined %}
    # relecture-ia : un certificat pour le site, l'admin et les workers.
    - certFile: /certs/relecture-ia/fullchain.pem
      keyFile: /certs/relecture-ia/privkey.pem
{% endif %}
