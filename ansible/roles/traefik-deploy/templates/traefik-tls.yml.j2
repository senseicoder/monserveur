{# Certs certbot copiés dans certs/ (cf. traefik_file_certs). Les domaines
   basculés sur ACME (traefik_acme_domains) sont exclus : sinon le cert
   certbot du TLS store resterait candidat pour ce SNI. #}
tls:
  certificates:
{% for c in traefik_file_certs if c.domain not in traefik_acme_domains %}
    - certFile: /certs/{{ c.dir ~ '/' if c.dir else '' }}fullchain.pem
      keyFile: /certs/{{ c.dir ~ '/' if c.dir else '' }}privkey.pem
{% endfor %}
{# relecture-ia hors traefik_file_certs : ses routeurs (mTLS) sont dans le
   fichier dynamique du rôle relecture-ia-deploy, pas en labels — la bascule
   ACME par traefik_acme_domains ne le couvre pas. #}
{% if relecture_domain is defined %}
    # relecture-ia : un certificat pour le site, l'admin et les workers.
    - certFile: /certs/relecture-ia/fullchain.pem
      keyFile: /certs/relecture-ia/privkey.pem
{% endif %}
