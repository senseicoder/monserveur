services:
  ntfy:
    image: {{ ntfy_image }}
    container_name: ntfy
    restart: unless-stopped
    command:
      - serve
    environment:
      TZ: "Europe/Paris"
      NTFY_BASE_URL: "https://{{ ntfy_domain }}:8787"
      NTFY_LISTEN_HTTP: ":80"
      NTFY_AUTH_FILE: "/var/lib/ntfy/auth.db"
      NTFY_AUTH_DEFAULT_ACCESS: "deny-all"
      NTFY_BEHIND_PROXY: "true"
{% if ntfy_relecture_hash | default('') and ntfy_relecture_jeton | default('') %}
      # Compte de service relecture-ia (ADR-039 de relecture-ia) : utilisateur, droit
      # en écriture seule sur son topic et jeton, provisionnés à chaque démarrage
      # (option vérifiée sur ntfy 2.26.3, la version en service le 2026-11-10). Le compte admin « cedric », créé à la main, n'est PAS listé ici :
      # ntfy supprime tout utilisateur provisionné qui disparaît de cette liste.
      # `$` du hash bcrypt doublé : docker-compose interpole `$`.
      NTFY_AUTH_USERS: {{ ('relecture:' ~ ntfy_relecture_hash ~ ':user') | replace('$', '$$') | to_json }}
      NTFY_AUTH_ACCESS: {{ ('relecture:' ~ ntfy_relecture_topic ~ ':wo') | to_json }}
      NTFY_AUTH_TOKENS: {{ ('relecture:' ~ ntfy_relecture_jeton ~ ':relecture-ia') | to_json }}
{% endif %}
    volumes:
      - "{{ mindwtr_deploy_dir }}/data/ntfy/cache:/var/cache/ntfy"
      - "{{ mindwtr_deploy_dir }}/data/ntfy/lib:/var/lib/ntfy"
    networks:
      - "{{ docker_network_name }}"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.ntfy.rule=Host(`{{ ntfy_domain }}`)"
      - "traefik.http.routers.ntfy.entrypoints=mindwtr,websecure"
      - "traefik.http.routers.ntfy.tls=true"
      - "traefik.http.services.ntfy.loadbalancer.server.port=80"
    security_opt:
      - seccomp:unconfined
    healthcheck:
      test: ["CMD-SHELL", "wget -q --tries=1 http://127.0.0.1/v1/health -O - | grep -Eo '\"healthy\"[[:space:]]*:[[:space:]]*true' || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3

networks:
  "{{ docker_network_name }}":
    external: true
