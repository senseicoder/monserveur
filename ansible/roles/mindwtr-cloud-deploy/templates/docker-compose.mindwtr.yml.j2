services:
  mindwtr-cloud:
    image: ghcr.io/dongdongbh/mindwtr-cloud:latest
    container_name: mindwtr-cloud
    restart: unless-stopped
    environment:
      MINDWTR_CLOUD_AUTH_TOKENS: "{{ mindwtr_token }}"
      MINDWTR_CLOUD_CORS_ORIGIN: "https://{{ mindwtr_domain }}:8787"
    volumes:
      - "{{ mindwtr_deploy_dir }}/data/cloud:/app/cloud_data"
    networks:
      - "{{ docker_network_name }}"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.mindwtr.rule=Host(`{{ mindwtr_domain }}`)"
      - "traefik.http.routers.mindwtr.entrypoints={{ traefik_https_entrypoints }}"
      - "traefik.http.routers.mindwtr.tls=true"
{% if traefik_acme_enabled and mindwtr_domain in traefik_acme_domains %}
      - "traefik.http.routers.mindwtr.tls.certresolver={{ traefik_acme_resolver }}"
{% endif %}
      - "traefik.http.services.mindwtr.loadbalancer.server.port=8787"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8787/health"]
      interval: 30s
      timeout: 5s
      retries: 3

networks:
  "{{ docker_network_name }}":
    external: true
